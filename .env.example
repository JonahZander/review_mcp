# Copy to .env and fill in secrets.
# docker-compose.yml loads this file for the mcp-server service.

# Provider selection: searchapi or serpapi
SEARCH_PROVIDER=serpapi

# SearchAPI credentials (required when SEARCH_PROVIDER=searchapi)
SEARCHAPI_API_KEY=replace_me
SEARCHAPI_BASE_URL=https://www.searchapi.io/api/v1/search

# SerpAPI credentials (required when SEARCH_PROVIDER=serpapi)
SERPAPI_API_KEY=replace_me
SERPAPI_BASE_URL=https://serpapi.com/search
SERPAPI_USE_NO_CACHE=false

# HTTP and retry tuning
HTTP_TIMEOUT_SECONDS=30
RETRY_ATTEMPTS=5
RETRY_MIN_SECONDS=1
RETRY_MAX_SECONDS=20
RETRY_JITTER_SECONDS=0.5
REVIEWS_FETCH_ALL_CAP=100

# PostgreSQL DSN. docker-compose.yml overrides this to point at the postgres
# service. For local runs without Docker, update host/port to match your setup.
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/reviews?options=-csearch_path%3Dgoogle_reviews%2Cpublic

# Logging
LOG_LEVEL=INFO
