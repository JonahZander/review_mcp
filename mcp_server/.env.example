# Search provider: searchapi or serpapi
SEARCH_PROVIDER=searchapi

# SearchAPI credentials (required when SEARCH_PROVIDER=searchapi)
SEARCHAPI_API_KEY=your_searchapi_key_here

# SerpAPI credentials (required when SEARCH_PROVIDER=serpapi)
SERPAPI_API_KEY=your_serpapi_key_here

# PostgreSQL connection string
POSTGRES_DSN=postgresql://postgres:postgres@postgres:5432/reviews

# Optional tuning
# HTTP_TIMEOUT_SECONDS=30
# RETRY_ATTEMPTS=5
# LOG_LEVEL=INFO
